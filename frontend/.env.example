# Leave VITE_API_URL unset so the app calls the API on the same host you open
# the app from (localhost, 127.0.0.1, or a LAN IP) on port 4000.
# Set it explicitly only when the API runs on a different host or port:
# VITE_API_URL=http://127.0.0.1:4000/api
# Production example: VITE_API_URL=https://api.example.com/api
