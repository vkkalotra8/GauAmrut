NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27018/gauamrut?replicaSet=gauamrut-rs
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
REDIS_URL=
# OTP emails are always sent to the registered address. Gmail requires a 16-character
# Google Account App Password (myaccount.google.com > App passwords), not your login password.
# SMTP_USER must be the full Gmail address, and SMTP_FROM must use that same address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GauAmrut <no-reply@example.com>
# Dev-only OTP visibility; leave false so codes are emailed instead of shown on screen.
DEV_SHOW_OTP=false
